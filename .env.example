# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase project (Dashboard → Project Settings → General).
# The API URL is derived from the project ref: https://<ref>.supabase.co
VITE_SUPABASE_URL="https://tyizrwkxmminvcgfvykw.supabase.co"
VITE_SUPABASE_PROJECT_REF="tyizrwkxmminvcgfvykw"
VITE_SUPABASE_REGION="eu-west-1"
# anon key: Dashboard → API keys. Client-readable (RLS is the real boundary).
# Auth, the catalog, orders, designs, reviews and shares all stay in localStorage
# until this is set. Enable the Google provider in Auth → Providers and add this
# origin to the redirect allow-list.
VITE_SUPABASE_ANON_KEY=""
# VITE_USE_SUPABASE_STORAGE: "true" uploads customer photos to the Supabase
# Storage bucket (needs the bucket + policies). Default "false" stores them as
# client-side compressed WebP data URLs (~60-100KB), no bucket required.
VITE_USE_SUPABASE_STORAGE="false"

# SITE_ORIGIN: Absolute origin baked into canonical/og URLs, robots.txt and sitemap.xml
# at build time. Defaults to https://cardly.app — set this to your real domain.
SITE_ORIGIN=""

# VITE_GA_ID: Google Analytics 4 measurement id (G-XXXXXXXXXX).
# Analytics stays completely disabled when this is empty.
VITE_GA_ID=""

# --- Stripe payments ---------------------------------------------------------
# The browser is redirected to Stripe's hosted checkout, so no card data, no
# publishable key and no Stripe SDK ever enters this bundle. Everything is an
# Edge Function secret (supabase secrets set …), never a VITE_ var:
#
#   supabase functions deploy create-checkout
#   supabase functions deploy stripe-webhook --no-verify-jwt   # Stripe sends no JWT
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_… STRIPE_WEBHOOK_SECRET=whsec_… SITE_ORIGIN=https://your-domain
#
# Webhook endpoint (Stripe Dashboard → Developers → Webhooks) pointing at
#   https://<project-ref>.supabase.co/functions/v1/stripe-webhook
# with events checkout.session.completed and checkout.session.expired.
# SITE_ORIGIN here is the same origin as the build-time SITE_ORIGIN above: it
# is what the success/cancel URLs are built from.
#
# Until they are set, checkout shows a clear error instead of pretending to
# take money — there is no simulated payment path any more.
#
# --- Fulfilment (a paid order must become a printed card) --------------------
# stripe-webhook calls the fulfil-order function when payment lands, which
# renders the order's designSnapshot and stores it in the private `print-files`
# bucket. Two optional secrets, both Edge Function secrets:
#
#   supabase functions deploy fulfil-order
#   supabase secrets set PDF_RENDER_URL=https://your-pdf-service/render
#
# PDF_RENDER_URL is a headless-Chromium service that takes {html} and returns a
# PDF. Omit it and the PDF step is skipped, not faked: the render is stored as
# `source_html` and an operator prints it by hand from /admin/.
#
# If you have a printer account (Gelato, Prodigi), set all three or none:
#   supabase secrets set PRINTER_API_URL=… PRINTER_API_KEY=… PRINTER_NAME=…
